# Linux VM API connects to the Windows host VMnet8 address, not localhost.
# URL-encode the password when it contains URL-reserved characters.
DATABASE_URL=mysql://lostfound:replace_me@WINDOWS_VMNET8_HOST:3308/lostfound
APP_JWT_SECRET=replace_with_at_least_32_random_characters
APP_STORAGE_MODE=remote
APP_STORAGE_BASE_URL=http://192.168.137.10:8081
APP_STORAGE_SHARED_SECRET=replace_with_at_least_32_random_characters
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
